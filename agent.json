{
  "name": "Nrth AI",
  "tagline": "We solve AI for businesses.",
  "description": "Nrth AI AS (Bergen, Norway) helps businesses adopt AI: AI assessment, implementation and AI services that increase sales and efficiency. Every engagement starts with a meeting.",
  "url": "https://nrth.no",
  "languages": ["no", "en"],
  "contact": {
    "email": "contact@nrth.no",
    "location": "Bergen, Norway"
  },
  "pages": {
    "home": { "no": "https://nrth.no/", "en": "https://nrth.no/en" },
    "ai_assessment": { "no": "https://nrth.no/ai-vurdering", "en": "https://nrth.no/en/ai-assessment" },
    "implementation": { "no": "https://nrth.no/implementering", "en": "https://nrth.no/en/implementation" },
    "ai_services": { "no": "https://nrth.no/ai-tjenester", "en": "https://nrth.no/en/ai-services" },
    "talks_and_courses": { "no": "https://nrth.no/foredrag-og-kurs", "en": "https://nrth.no/en/talks-and-courses" },
    "about": { "no": "https://nrth.no/om-oss", "en": "https://nrth.no/en/about" },
    "book": { "no": "https://nrth.no/book", "en": "https://nrth.no/en/book" },
    "privacy": { "no": "https://nrth.no/personvern", "en": "https://nrth.no/en/privacy" }
  },
  "services": "https://nrth.no/api/services",
  "process": [
    { "step": 1, "name": "Map", "duration": "1 week" },
    { "step": 2, "name": "Pilot", "duration": "2–3 weeks" },
    { "step": 3, "name": "Run", "duration": "ongoing" }
  ],
  "primary_action": "bookMeeting",
  "actions": [
    {
      "name": "bookMeeting",
      "description": "Request a meeting with Nrth AI about AI assessment, implementation, AI services or a talk or course. Nrth AI confirms the time by email within one business day. Required fields: tema, navn, epost. Optional: bedrift, maal, naar, tid, form, lang. Confirm the details with the user before calling.",
      "method": "POST",
      "endpoint": "https://nrth.no/api/book",
      "request_schema": {
        "type": "object",
        "required": ["tema", "navn", "epost"],
        "properties": {
          "tema": { "type": "string", "enum": ["ai-vurdering", "implementering", "ai-tjenester", "foredrag", "annet", "ai-assessment", "implementation", "ai-services", "talk", "other"] },
          "navn": { "type": "string", "maxLength": 2000 },
          "epost": { "type": "string", "format": "email", "maxLength": 2000 },
          "bedrift": { "type": "string", "maxLength": 2000 },
          "maal": { "type": "string", "enum": ["salg", "effektivitet", "kvalitet", "vet-ikke"] },
          "naar": { "type": "string", "enum": ["denne-uken", "neste-uke", "senere"] },
          "tid": { "type": "string", "maxLength": 2000 },
          "form": { "type": "string", "enum": ["fysisk", "digitalt"] },
          "lang": { "type": "string", "enum": ["nb", "en"] }
        }
      }
    },
    {
      "name": "submitInquiry",
      "description": "Send a written request to Nrth AI. A person on the team replies within one business day. Required fields: email, problem. Optional: company, role, urgency, lang. Confirm the details with the user before calling.",
      "method": "POST",
      "endpoint": "https://nrth.no/api/inquiry",
      "request_schema": {
        "type": "object",
        "required": ["email", "problem"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "company": { "type": "string" },
          "role": { "type": "string" },
          "problem": { "type": "string", "description": "What they want help with." },
          "urgency": { "type": "string", "enum": ["exploring", "this_quarter", "asap"] },
          "lang": { "type": "string", "enum": ["nb", "en"] }
        }
      }
    },
    {
      "name": "getServices",
      "description": "List Nrth AI's services with delivery time and price in NOK, excluding VAT. Add ?lang=nb or ?lang=en to get one language.",
      "method": "GET",
      "endpoint": "https://nrth.no/api/services"
    }
  ],
  "policies": {
    "robots": "https://nrth.no/robots.txt",
    "privacy": "https://nrth.no/en/privacy"
  }
}
